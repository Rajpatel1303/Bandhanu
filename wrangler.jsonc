{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bandhanu",
  "main": "./server/index.ts",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bandhanu-db",
      "database_id": "2f5c3a04-1852-4749-9817-82d715216116"
    }
  ],
  "routes": [
    {
      "pattern": "bandhanu.in",
      "custom_domain": true
    },
    {
      "pattern": "www.bandhanu.in",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
